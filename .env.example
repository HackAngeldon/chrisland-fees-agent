# Paystack TEST secret key (sk_test_...). Live keys are refused.
PAYSTACK_SECRET_KEY=
# Random 24+ character tokens, different from each other. Chord sends them as Bearer tokens.
PARENTS_TOKEN=
BURSAR_TOKEN=
# An inbox you own: parents' Paystack emails become plus addresses on it (you+chr-bello@...).
# Empty: reserved example.com addresses.
TEST_INBOX=
# Public base URL of this server, for the page Paystack returns the parent to (optional).
PUBLIC_BASE_URL=
# 1 when the Paystack account passes its fee to customers (checkout then shows amount + fee).
PARENT_PAYS_PAYSTACK_FEE=
# 1 = keep the last 50 tool-call headers at GET /debug/requests (bursar token).
CAPTURE_REQUESTS=1
# Pin "today" (YYYY-MM-DD) for tests and the recording; leave empty for the real Lagos date.
DEMO_TODAY=
PORT=8787
